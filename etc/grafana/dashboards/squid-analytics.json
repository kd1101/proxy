          "rawSql": "WITH normalized AS (SELECT CASE WHEN url ~* '^https?://' THEN regexp_replace(url, '^https?://([^/:?#]+).*$', '\\1', 'i') ELSE regexp_replace(url, '^([^/:?#]+).*$','\\1') END AS site, bytes_sent, duration_ms, http_status FROM squid_access_log WHERE $__timeFilter(occurred_at)) SELECT site, COUNT(*)::bigint AS requests, SUM(bytes_sent)::bigint AS traffic, ROUND(AVG(duration_ms))::bigint AS avg_duration_ms, COUNT(*) FILTER (WHERE http_status >= 400)::bigint AS errors FROM normalized WHERE site IS NOT NULL AND site <> '' GROUP BY site ORDER BY traffic DESC NULLS LAST LIMIT 20;",
